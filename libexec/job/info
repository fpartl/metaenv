#!/bin/bash
# A PBS job (also a finished one): an overview, with -c also the commands to connect to it while it runs (as job session
# prints them), with -e how much of its CPUs and memory it uses, -v all of these; or the given attributes one per line
# in their order (an empty line when missing). Without an id, the job you are in (PBS_JOBID: a batch job, job shell).
#
#   job info                                         # the job you are in
#   job info -c 1234567                              # its state, resources, time, folders and how to connect
#   job info -e 1234567                              # how much of the requested CPUs and memory it uses
#   job info -v 1234567                              # all of it
#   job info 1234567 job_state exec_host2 Output_Path   # `id` is the full job id; all attributes: qstat -xwf <id>

set -euo pipefail

usage() {
    echo "usage: job info [-c] [-e] [-v] [job-id] | job info <job-id> <attribute>... (without an id only in a job)" >&2
    exit 2
}

# the options anywhere, also after the id (getopts stops at it); attributes never start with a dash
connect=0 efficiency=0 args=()
for arg in "$@"; do
    if [[ ! $arg =~ ^- ]]; then
        args+=("$arg")
    elif [[ $arg =~ ^-[cev]+$ ]]; then
        if [[ $arg == *[cv]* ]]; then
            connect=1
        fi
        if [[ $arg == *[ev]* ]]; then   # -v: every extra
            efficiency=1
        fi
    else
        usage
    fi
done
set -- "${args[@]}"
if (( $# == 0 )) && [[ -z ${PBS_JOBID:-} ]] || (( (connect || efficiency) && $# > 1 )); then
    usage
fi
id=${1:-$PBS_JOBID}
shift || true

# The attributes of the job, one per line. Plain `qstat -f` instead of `-F json`, whose escaping of the job's
# environment is not always valid JSON.
attributes() {
    qstat -x -w -f "$id" | python3 -c '
import sys

attrs, key = {}, None
for line in sys.stdin:
    line = line.rstrip("\n")
    if line.startswith("Job Id: "):
        attrs["id"] = line.removeprefix("Job Id: ")
    elif line.startswith("\t") and key:  # continuation of a long value
        attrs[key] += line.lstrip("\t")
    elif " = " in line:
        key, value = line.strip().split(" = ", 1)
        attrs[key] = value

for name in sys.argv[1:]:
    print(attrs.get(name, ""))
' "$@"
}

if (( $# > 0 )); then
    attributes "$@"
    exit
fi

# not $(…), it drops the empty lines of missing attributes; a failure of qstat (unknown job, its message goes to the
# terminal) leaves no id
mapfile -t f < <(attributes id Job_Name job_state comment Exit_status exec_host2 Resource_List.ncpus \
    Resource_List.mem Resource_List.ngpus Resource_List.scratch_local Resource_List.scratch_ssd \
    Resource_List.scratch_shared Resource_List.scratch_shm stime Resource_List.walltime resources_used.walltime \
    Variable_List resources_used.cput resources_used.mem)
if [[ -z ${f[0]} ]]; then
    exit 1
fi
short_id=${f[0]%%.*} name=${f[1]} state=${f[2]} comment=${f[3]} exit_status=${f[4]} host=${f[5]%%[:+]*}
stime=${f[13]} walltime=${f[14]} used=${f[15]} cput=${f[17]} mem_used=${f[18]}
var() {
    grep -o "$1=[^,]*" <<< "${f[16]}" | cut -d= -f2 || true
}
scratchdir=$(var SCRATCHDIR) folder=$(var PBS_O_WORKDIR)

# PBS's comment repeats the node, resources and start of a running job; it tells why one waits or how it ended
case $state in
    R) state=running comment="" ;;
    Q) state=queued ;;
    H) state=held ;;
    W) state=waiting ;;
    F) state="finished${exit_status:+, exit status $exit_status}" ;;
esac

resources="${f[6]} CPUs, ${f[7]} memory"
if [[ ${f[8]:-0} != 0 ]]; then
    resources+=", ${f[8]} GPUs"
fi
scratch_size=""
for i in 9 10 11 12; do
    scratch_size=${scratch_size:-${f[i]}}
done

time="walltime $walltime"
if [[ -n $stime ]]; then
    IFS=: read -r h m s <<< "$walltime"
    start=$(date -d "$stime" +%s)
    end=$(( start + 10#$h * 3600 + 10#$m * 60 + 10#$s ))
    # the end without its date on the day of the start
    end_format='+%Y-%m-%d %H:%M'
    if [[ $(date -d "@$start" +%F) == $(date -d "@$end" +%F) ]]; then
        end_format=+%H:%M
    fi
    time="$(date -d "@$start" '+%Y-%m-%d %H:%M') – $(date -d "@$end" "$end_format")"
    time+=", used ${used:-0:00:00} of $walltime"
fi

cat <<EOF
job $short_id  $name
  state      $state${comment:+ ($comment)}
  node       ${host:--}
  resources  $resources
  scratch    ${scratchdir:--}${scratch_size:+ ($scratch_size)}
  time       $time
  folder     $folder
EOF

# hh:mm:ss -> seconds
seconds() {
    local h m s
    IFS=: read -r h m s <<< "$1"
    echo $(( 10#$h * 3600 + 10#$m * 60 + 10#$s ))
}
# a size of PBS (16gb, 3355443kb, ...) -> kB
kilobytes() {
    local number=${1%%[a-z]*} unit=${1##*[0-9]}
    case $unit in
        b) echo $(( number / 1024 )) ;;
        kb) echo "$number" ;;
        mb) echo $(( number * 1024 )) ;;
        gb) echo $(( number * 1024 ** 2 )) ;;
        tb) echo $(( number * 1024 ** 3 )) ;;
    esac
}
# The average use of the requested CPUs (CPU time of the job's processes over the time it runs) and the memory used,
# as PBS measures them in the job's cgroup; nothing before the job runs.
if (( efficiency )) && [[ -n $used && -n $cput && -n $mem_used ]] && (( $(seconds "$used") > 0 )); then
    cpu_use=$(( 100 * $(seconds "$cput") / ($(seconds "$used") * f[6]) ))
    mem_kb=$(kilobytes "$mem_used") mem_requested_kb=$(kilobytes "${f[7]}")
    mem_use=$(( 100 * mem_kb / mem_requested_kb ))
    mem_gb=$(awk -v kb="$mem_kb" 'BEGIN { printf "%.1f", kb / 1024 / 1024 }')
    echo "  cpu use    $cpu_use% of ${f[6]} CPUs (CPU time $cput)"
    echo "  mem use    $mem_use% of ${f[7]} ($mem_gb gb)"
fi

if (( ! connect )) || [[ $state != running ]]; then
    exit 0
fi

# An SSH login to the node lands outside the job, in the node's own home; job shell moves the shell into the job
# (pbs_attach: its CPUs and memory), with the home metaenv is installed in, the scratch and the folder. From your
# machine `ssh <node>` runs it by RemoteCommand in ~/.ssh/config (README: SSH to the nodes), and so does VS Code, but
# without an id only for a session (job session); a batch job needs its id.
job=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../bin/metacentrum" && pwd)/job
from_frontend="job shell $short_id"
# the commands without indentation and on lines of their own, so that a triple click selects exactly one of them
echo
echo "from a frontend:"
echo "$from_frontend"
echo
echo "from your machine (README: SSH to the nodes):"
if [[ $name == session-* ]]; then
    echo "ssh $host"
    echo
    echo "VS Code (README: SSH to the nodes):"
    printf 'code --remote ssh-remote+%s %q\n' "$host" "$folder"
else
    echo "ssh -o RemoteCommand='$job shell $short_id' $host"
fi
cat <<EOF

extend it:
job extend $short_id <hours>

end it:
job kill $short_id
EOF
