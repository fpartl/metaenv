#!/bin/bash
# A command of a uv project in a job (as `uv run`), for the job scripts of projects: in the environment of uv.lock
# synced into the job's scratch offline, only from uv's cache in your home (`uv sync` of the project on a frontend or
# in a session fills it), so the node needs no git server or SSH keys. With COMMIT, in a clone of that commit in the
# scratch, so that changes of the project after qsub do not get into the job.
#
# The project is the folder qsub was run in (PBS_O_WORKDIR), else the current one (job shell). A batch job does not
# read ~/.bashrc, call it by its full path there:
#
#   #PBS -l select=1:ncpus=1:mem=24gb:scratch_local=10gb
#   trap clean_scratch EXIT TERM
#   /storage/plzen1/home/$USER/tools/metaenv/bin/metacentrum/job run python -O app/train.py --epochs 10
#
#   qsub -v COMMIT=$(git rev-parse HEAD) app/train.sh      # in the project
#   job run python app/train.py                            # in a session: the working tree

set -euo pipefail

if (( $# == 0 )); then
    echo "usage: job run <command> [arguments]   (COMMIT=<sha> in the environment: the clone of a commit)" >&2
    exit 2
fi
: "${SCRATCHDIR:?not in a job with a scratch (scratch_local=…)}"

# the home of the frontend (PBS gives the node's own one): uv's cache and Pythons are there; uv where its installer
# (~/.local/bin) or `pixi global` (~/.pixi/bin) puts it
export HOME=${PBS_O_HOME:-$HOME}
export PATH=$HOME/.local/bin:$HOME/.pixi/bin:$PATH
# temporary files into the scratch (as tmp-to-scratch), /tmp of the node has a small limit
export TMPDIR=$SCRATCHDIR/tmp
mkdir -p "$TMPDIR"
# the environment on the node's disk; the cache is on another file system, so copies instead of hard links
export UV_PROJECT_ENVIRONMENT=$SCRATCHDIR/venv UV_LINK_MODE=copy

cd "${PBS_O_WORKDIR:-$PWD}"
if [[ -n ${COMMIT:-} ]]; then
    # the same subfolder of the clone; a clone of an earlier `job run` of the job is reused
    prefix=$(git rev-parse --show-prefix) clone=$SCRATCHDIR/repo-$COMMIT
    if [[ ! -d $clone ]]; then
        git clone --quiet "$(git rev-parse --show-toplevel)" "$clone"
        git -C "$clone" checkout --quiet --detach "$COMMIT"
    fi
    cd "$clone/$prefix"
fi
echo "job run: $PWD${COMMIT:+ (commit $COMMIT)}" >&2

if ! uv sync --frozen --offline; then
    echo "job run: uv sync failed; missing in uv's cache? \`uv sync\` in the project (frontend, session) fills it" >&2
    exit 1
fi
exec uv run --frozen --offline --no-sync "$@"
