#!/bin/bash
#PBS -N sif-job
#PBS -m n
# A PBS job running a command of a project at an exact commit in the image of its environment:
#
#   qsub -l select=1:ncpus=4:mem=16gb:scratch_local=20gb -l walltime=4:00:00 \
#       -v REPO=<git url or path>,COMMIT=<sha>,IMAGES=<dir of images>,CMD='<command>'[,OUTPUT=output,OUTPUT_TO=<dir>] \
#       /…/metaenv/bin/metacentrum/sif-job
#
# 1. clones REPO into the scratch and checks out COMMIT;
# 2. takes the image `IMAGES/<name>-<tag>.sif` of that commit (name = NAME or the name of the repository, tag as in
#    sif-tag), fails at once when it is missing;
# 3. runs CMD in the image, with the clone at /app (the image keeps its environment outside /app, e.g. /opt/venv);
# 4. copies OUTPUT (a folder of the clone, `output` by default) into OUTPUT_TO, when given, and cleans the scratch;
#    when the copying fails, the scratch stays for a manual rescue.

set -euo pipefail

: "${REPO:?missing REPO}" "${COMMIT:?missing COMMIT}" "${IMAGES:?missing IMAGES}" "${CMD:?missing CMD}"
: "${SCRATCHDIR:?not in a job with a scratch (scratch_local=…)}"
repo=$SCRATCHDIR/repo

# temporary files into the scratch (as tmp-to-scratch), /tmp of the node has a small limit; the image gets TMPDIR too,
# Singularity passes the environment and the scratch is bound
export TMPDIR=$SCRATCHDIR/tmp
mkdir -p "$TMPDIR"

finish() {
    local status=$?
    if [[ -n ${OUTPUT_TO:-} && -d $repo/${OUTPUT:-output} ]]; then
        if ! { mkdir -p "$OUTPUT_TO" && cp -r "$repo/${OUTPUT:-output}/." "$OUTPUT_TO/"; }; then
            echo "copying the output to $OUTPUT_TO failed, it stays in $(hostname -f):$SCRATCHDIR" >&2
            exit 1
        fi
        echo "output copied to $OUTPUT_TO"
    fi
    clean_scratch
    exit "$status"
}
trap finish EXIT

echo "job ${PBS_JOBID:-?} on $(hostname -f): $REPO @ $COMMIT"
git clone --quiet "$REPO" "$repo"
git -C "$repo" checkout --quiet --detach "$COMMIT"

name=${NAME:-$(basename "$REPO" .git)}
tag=$(cat "$repo/uv.lock" "$repo/Dockerfile" | sha256sum | cut -c1-12)   # the same as sif-tag
image="$IMAGES/${name,,}-$tag.sif"
if [[ ! -f $image ]]; then
    echo "missing image $image, build it in the project at this commit: sif-build $IMAGES" >&2
    exit 1
fi

options=(-B "$SCRATCHDIR" -B "$repo:/app" --pwd /app)
if [[ -n ${CUDA_VISIBLE_DEVICES:-} ]]; then
    options+=(--nv)
fi
echo "image $image, command: $CMD"
singularity exec "${options[@]}" "$image" bash -c "$CMD"
